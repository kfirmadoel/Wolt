FROM node:24-bookworm-slim
WORKDIR /app/mobile
COPY package*.json ./
# Optional trusted CA for local HTTPS inspection during package installation.
RUN --mount=type=secret,id=npm_ca \
    if [ -f /run/secrets/npm_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/npm_ca; fi && npm ci
COPY . ./
ENV CI=1
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8081/status').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "node_modules/expo/bin/cli", "start", "--go", "--lan", "--port", "8081"]
