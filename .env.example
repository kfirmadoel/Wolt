# Local development only; choose a different JWT secret for shared environments.
JWT_SECRET=temporary-dev-key-change-me
WEB_PORT=3000
METRO_PORT=8081

# Defaults match ADB reverse for ports 3000 and 8081.
# When changing ports or using a phone over LAN, update both URLs too.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PACKAGER_PROXY_URL=http://127.0.0.1:8081
